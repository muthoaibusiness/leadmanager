# Supabase (Vite client config — VITE_ prefix is required to expose to the app)
# Copy this file to .env and fill in real values. Never commit the real .env.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── WhatsApp (Wasender) ──────────────────────────────────────────────────────
# Two numbers, one Wasender session each. Leads in the Dubai team are handled
# from the DUBAI session; every other lead from the EYAD session.
#
# Relay + inbound webhook run on n8n at https://n8n.mutholab.com
#   Relay URL (Chat Settings → Relay URL):
#     https://n8n.mutholab.com/webhook/wecon-whatsapp-send
#   Wasender webhook URL per session (paste into each session's settings):
#     Dubai: https://n8n.mutholab.com/webhook/wecon-whatsapp?account=dubai
#     Eyad : https://n8n.mutholab.com/webhook/wecon-whatsapp?account=eyad
#   Tokens live in n8n Header Auth credentials (one per number) — see
#   config/n8n-wa-send-relay.json and config/n8n-wa-chat-inbound.json.
#
# If you run the Supabase Edge Functions instead of n8n, the same tokens go in
# as function secrets:  npx supabase secrets set --env-file .env
# then redeploy wa-send / wa-webhook. Tokens stored from Chat Settings in the
# app (wa_secrets table) take precedence over these and can be rotated live.

# Dubai team
WASENDER_API_TOKEN_DUBAI=
WASENDER_WEBHOOK_SECRET_DUBAI=

# Eyad (everyone else)
WASENDER_API_TOKEN_EYAD=
WASENDER_WEBHOOK_SECRET_EYAD=

# Legacy single-session values — used as the EYAD fallback while the two
# entries above are empty. Remove once both accounts are filled in.
WASENDER_API_TOKEN=
WASENDER_WEBHOOK_SECRET=

# Team name (case-insensitive substring) whose leads route to the Dubai number.
# Vite var: read by the app when it decides which thread to open.
VITE_WA_DUBAI_TEAM=Dubai

# Origin allowed to call the Edge Functions. Defaults to * when unset.
ALLOWED_ORIGIN=*
