# Supabase (Vite client config — VITE_ prefix is required to expose to the app)
# Copy this file to .env and fill in real values. Never commit the real .env.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: where human WhatsApp sends go. Fixed at build time (CR-001 CR-2);
# defaults to <VITE_SUPABASE_URL>/functions/v1/wa-send. Never read from the database.
# VITE_WA_RELAY_URL=
